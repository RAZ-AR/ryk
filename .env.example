# Ryk — пример переменных окружения.
# Реальные значения НЕ коммитим: заполняются в Vercel / Supabase / локальном .env.local.
# Список источников и что бесплатно — см. ryk_docs/18-decisions-adr.md (чек-лист).

# --- Database (Supabase Postgres / Prisma) ---
# В Supabase → Project Settings → Database два разных URL, и их нельзя путать:
#   DATABASE_URL — пул (Connection pooling, порт 6543). Его использует приложение.
#   DIRECT_URL   — прямое подключение (порт 5432). По нему идут миграции и сиды:
#                  через pgbouncer миграции не работают.
DATABASE_URL=
DIRECT_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram Mini App (bot @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Подпись сессии (JWT в httpOnly-cookie) ---
# Обязателен в production; локально есть небезопасный fallback. Сгенерировать:
#   openssl rand -base64 32
SESSION_SECRET=

# --- AI: разбор желаний (ADR-008) ---
# Приоритет 1: Google Gemini — бесплатный tier, ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Приоритет 2 (опционально, платный): Anthropic Claude — точнее, включается вместо Gemini,
# только если GEMINI_API_KEY пуст.
ANTHROPIC_API_KEY=
# Без обоих ключей работает эвристика по ключевым словам — флоу не ломается.

# --- Analytics (PostHog, EU) — ADR-005 ---
# Без ключа аналитика — тихий no-op: продукт работает, события не шлются.
# Ключ: PostHog → Project settings → Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Concierge: внутренний инструмент куратора (/concierge, ADR-006) ---
# Общий токен доступа куратора. Без него раздела не существует вовсе (404).
# Минимум 16 символов. Сгенерировать: openssl rand -base64 24
CONCIERGE_TOKEN=

# --- Данные (опционально, по мере надобности) ---
# Погода Open-Meteo и OSM Nominatim/Overpass ключа НЕ требуют.
NEXT_PUBLIC_MAPBOX_TOKEN=
TICKETMASTER_API_KEY=
